{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "bun"
    ]
  },
  "extends": "./.trebired/code-discipline/generated/tsconfig.paths.json",
  "include": [
    "src/**/*.ts",
    ".trebired/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
